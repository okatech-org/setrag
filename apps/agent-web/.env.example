# Déploiement Convex — renseigné automatiquement par `bunx convex dev`
NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://<deployment>.convex.site

# Activer seulement après déploiement des fonctions modules/platform sur Convex
NEXT_PUBLIC_PLATFORM_MODULES_API=0

# Origine publique de la billetterie
NEXT_PUBLIC_SITE_URL=http://localhost:3001
