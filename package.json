{
  "name": "setrag",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "typecheck": "turbo typecheck",
    "test": "turbo test:once",
    "dev:billetterie": "turbo dev --filter=billetterie-web",
    "dev:agent": "turbo dev --filter=agent-web",
    "dev:controleur": "turbo dev --filter=controleur-web",
    "dev:mobile": "bun run --filter=voyageur-mobile start",
    "dev:convex": "bun run --filter=@workspace/backend dev",
    "deploy:convex": "bun run --filter=@workspace/backend deploy",
    "seed": "bun run --filter=@workspace/backend seed"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "//overrides": "Une seule instance de better-auth dans le graphe : deux copies produisent des types nominalement incompatibles entre les plugins (expo, convex) et le client.",
  "overrides": {
    "better-auth": "1.6.25"
  }
}
