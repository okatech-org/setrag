{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "billetterie-web",
      "url": "http://localhost:3000",
      "port": 3000
    },
    {
      "name": "billetterie-web-prod",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "--filter=billetterie-web", "start:verif"],
      "port": 3005,
      "autoPort": false
    },
    {
      "name": "controleur-web",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "--filter=controleur-web", "dev"],
      "port": 3002,
      "autoPort": false
    },
    {
      "name": "agent-web",
      "runtimeExecutable": "bun",
      "runtimeArgs": ["run", "--filter=agent-web", "dev"],
      "port": 3001,
      "autoPort": false
    },
    {
      "name": "agent-web-platform",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_PUBLIC_PLATFORM_MODULES_API=1",
        "bun",
        "run",
        "--filter=agent-web",
        "dev"
      ],
      "port": 3001,
      "autoPort": false
    }
  ]
}
