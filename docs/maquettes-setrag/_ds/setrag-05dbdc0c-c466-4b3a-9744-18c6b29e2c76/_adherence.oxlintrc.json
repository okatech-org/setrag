{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use <Button> from the design system instead of <button>."
          },
          {
            "element": "input",
            "message": "Use <Checkbox> from the design system instead of <input>."
          },
          {
            "element": "input",
            "message": "Use <Input> from the design system instead of <input>."
          },
          {
            "element": "input",
            "message": "Use <Radio> from the design system instead of <input>."
          },
          {
            "element": "textarea",
            "message": "Use <Textarea> from the design system instead of <textarea>."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/general/AppHeader/**",
              "components/general/Avatar/**",
              "components/general/Badge/**",
              "components/general/Button/**",
              "components/general/Card/**",
              "components/general/CardContent/**",
              "components/general/CardDescription/**",
              "components/general/CardFooter/**",
              "components/general/CardHeader/**",
              "components/general/CardTitle/**",
              "components/general/Checkbox/**",
              "components/general/EmptyState/**",
              "components/general/Field/**",
              "components/general/FilterGroup/**",
              "components/general/InlineMessage/**",
              "components/general/Input/**",
              "components/general/Radio/**",
              "components/general/RadioGroup/**",
              "components/general/RangeFilter/**",
              "components/general/ResultsToolbar/**",
              "components/general/SearchSlot/**",
              "components/general/SegmentedControl/**",
              "components/general/SelectNative/**",
              "components/general/Separator/**",
              "components/general/Skeleton/**",
              "components/general/SkeletonLines/**",
              "components/general/Stepper/**",
              "components/general/Switch/**",
              "components/general/Tabs/**",
              "components/general/TabsContent/**",
              "components/general/TabsList/**",
              "components/general/TabsTrigger/**",
              "components/general/Tag/**",
              "components/general/Textarea/**",
              "components/general/ToastBar/**",
              "components/voyage/BoardingPass/**",
              "components/voyage/CheckoutSummary/**",
              "components/voyage/PriceCalendar/**",
              "components/voyage/Ticket/**",
              "components/voyage/TrafficBanner/**",
              "components/voyage/TripResultCard/**",
              "components/voyage/TripSearchBar/**",
              "components/voyage/WalletPass/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Schibsted Grotesk Variable|IBM Plex Mono|Schibsted Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Schibsted Grotesk Variable, IBM Plex Mono, Schibsted Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:links|brand|actions|ref|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<AppHeader> doesn't accept that prop. Declared props: links, brand, actions, ref, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|src|ref|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, size, src, ref, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Avatar> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:ref|className|id|style|children|variant|asChild|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: ref, className, id, style, children, variant, asChild."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|secondary|outline|success|warning|destructive|info)$/]",
        "message": "<Badge> variant must be one of 'default' | 'secondary' | 'outline' | 'success' | 'warning' | 'destructive' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BoardingPass'] > JSXAttribute > JSXIdentifier[name!=/^(?:countdownLabel|routeLabel|coachLabel|seatLabel|platformLabel|reference|qrCode|onAddToWallet|onExchange|ref|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<BoardingPass> doesn't accept that prop. Declared props: countdownLabel, routeLabel, coachLabel, seatLabel, platformLabel, reference, qrCode, onAddToWallet, onExchange, ref, className, id, style, children."
      },
