# Déploiement Convex — généré par `bun run dev` depuis ce package
CONVEX_DEPLOYMENT=dev:<deployment>
CONVEX_URL=https://<deployment>.convex.cloud
CONVEX_SITE_URL=https://<deployment>.convex.site

# ─────────────────────────────────────────────────────────────────────────────
# Les secrets se posent sur le déploiement Convex, pas dans ce fichier.
# Depuis packages/backend :
#
#   bunx convex env set BETTER_AUTH_SECRET "$(openssl rand -base64 36)"
#   bunx convex env set SITE_URL "http://localhost:3000"
#   bunx convex env set TRUSTED_ORIGINS "http://localhost:3000,http://localhost:3001"
#   bunx convex env set DEV_SIGNIN_ENABLED "true"
#
# Pour l'envoi d'e-mails (composant Resend) :
#   bunx convex env set RESEND_API_KEY "re_..."
#   bunx convex env set RESEND_WEBHOOK_SECRET "whsec_..."
#   bunx convex env set TICKETS_EMAIL_FROM "SETRAG Billets <billets@setrag.ga>"
#   bunx convex env set TICKETS_EMAIL_ENABLED "true"
#   bunx convex env set RESEND_TEST_MODE "false"
#
# Connexion / création de compte par OTP e-mail :
#   bunx convex env set AUTH_EMAIL_FROM "SETRAG <connexion@billets.setrag.ga>"
#   bunx convex env set AUTH_EMAIL_ENABLED "true"
#
# Billets Apple Wallet (.pkpass) :
#   bunx convex env set APPLE_WALLET_PASS_TYPE_ID "pass.ga.setrag.billet"
#   bunx convex env set APPLE_WALLET_TEAM_ID "5Y39TTNCM7"
#   bunx convex env set APPLE_WALLET_SIGNER_CERTIFICATE "<certificat PEM>"
#   bunx convex env set APPLE_WALLET_SIGNER_PRIVATE_KEY "<clé privée PEM>"
#   bunx convex env set APPLE_WALLET_WWDR_CERTIFICATE "<Apple WWDR G4 PEM>"
#
# Billets Google Wallet :
#   bunx convex env set GOOGLE_WALLET_ISSUER_ID "<issuer ID>"
#   bunx convex env set GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL "<service account>"
#   bunx convex env set GOOGLE_WALLET_PRIVATE_KEY_BASE64 "<clé PEM en base64>"
#
# En développement uniquement, permet à l'interface de récupérer le code OTP
# sans fournisseur. Ne jamais activer cet interrupteur en production :
#   bunx convex env set DEV_SIGNIN_ENABLED "true"
#
# Webhook Resend à déclarer avec tous les événements email.* :
#   https://<deployment>.convex.site/webhooks/resend
#
# Assistants IA texte (OpenAI par défaut, Anthropic et Google disponibles) :
#   bunx convex env set AI_TEXT_PROVIDER "openai"
#   bunx convex env set OPENAI_API_KEY "sk-..."
#   bunx convex env set ANTHROPIC_API_KEY "sk-ant-..."
#   bunx convex env set GEMINI_API_KEY "..."
#   bunx convex env set AI_OPENAI_MODEL "gpt-5.6-luna"
#
# Assistant vocal OpenAI Realtime :
#   bunx convex env set AI_REALTIME_ENABLED "true"
#   bunx convex env set AI_REALTIME_MODEL "gpt-realtime-2.1-mini"
#   bunx convex env set AI_REALTIME_VOICE "marin"
#   # Optionnel : clé distincte de OPENAI_API_KEY
#   bunx convex env set AI_REALTIME_API_KEY "sk-..."
#
# Messagerie multicanale — Telegram est le premier adaptateur :
#   bunx convex env set MESSAGING_SESSION_SECRET "$(openssl rand -base64 48)"
#   bunx convex env set TELEGRAM_BOT_TOKEN "<token fourni par BotFather>"
#   bunx convex env set TELEGRAM_WEBHOOK_SECRET "$(openssl rand -hex 32)"
#
# Après le déploiement, enregistrer le webhook avec le secret ci-dessus :
#   curl -X POST "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#     -H "Content-Type: application/json" \
#     -d '{"url":"https://<deployment>.convex.site/webhooks/telegram","secret_token":"<WEBHOOK_SECRET>","allowed_updates":["message","callback_query"]}'
# ─────────────────────────────────────────────────────────────────────────────
