# Déploiement Convex — généré par `bun run dev` depuis ce package
CONVEX_DEPLOYMENT=dev:<deployment>
CONVEX_URL=https://<deployment>.convex.cloud
CONVEX_SITE_URL=https://<deployment>.convex.site

# ─────────────────────────────────────────────────────────────────────────────
# Les secrets se posent sur le déploiement Convex, pas dans ce fichier.
# Depuis packages/backend :
#
#   bunx convex env set BETTER_AUTH_SECRET "$(openssl rand -base64 36)"
#   bunx convex env set SITE_URL "http://localhost:3000"
#   bunx convex env set TRUSTED_ORIGINS "http://localhost:3000,http://localhost:3001"
#   bunx convex env set DEV_SIGNIN_ENABLED "true"
#
# Pour l'envoi d'e-mails (composant Resend) :
#   bunx convex env set RESEND_API_KEY "re_..."
#   bunx convex env set RESEND_WEBHOOK_SECRET "whsec_..."
# ─────────────────────────────────────────────────────────────────────────────
