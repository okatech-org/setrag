{
  "name": "@workspace/backend",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "convex dev",
    "deploy": "convex deploy",
    "seed": "convex run seeds/referential:run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex",
    "test": "vitest",
    "test:once": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text",
    "seed:reset": "convex run seeds/referential:reset",
    "ressources": "bun scripts/generer-polices.mjs && bun scripts/generer-images-wallet.mjs",
    "itest:up": "bash docker/up.sh",
    "itest:down": "bash docker/down.sh",
    "itest": "vitest run --config vitest.integration.config.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./generated": "./convex/_generated/api.js",
    "./modules": "./convex/modules/platform/catalog.ts",
    "./permissions": "./convex/model/permissions.ts",
    "./schema": "./convex/schema.ts",
    "./barcode": "./convex/model/barcode.ts",
    "./fares": "./convex/model/fares.ts",
    "./cgv": "./convex/model/cgv.ts",
    "./titulaire": "./convex/model/titulaire.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.69",
    "@ai-sdk/google": "^4.0.86",
    "@ai-sdk/openai": "^4.0.82",
    "@convex-dev/aggregate": "^0.2.2",
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/rate-limiter": "^0.3.2",
    "@convex-dev/resend": "^0.2.5",
    "@noble/ed25519": "^2",
    "@noble/hashes": "^1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@workspace/shared": "workspace:*",
    "@workspace/ui": "workspace:*",
    "ai": "^7.0.123",
    "better-auth": "^1.6.25",
    "bwip-js": "^4.11.2",
    "convex": "^1.42.3",
    "convex-helpers": "^0.1.120",
    "passkit-generator": "^3.4.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "resend": "^6.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.10",
    "@vitest/coverage-v8": "4.1.10",
    "@workspace/tsconfig": "workspace:*",
    "convex-test": "^0.0.54",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "zxing-wasm": "^3.1.2"
  }
}
